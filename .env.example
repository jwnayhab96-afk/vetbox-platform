# VetBox Platform Environment Variables

# Supabase Public Keys (Client & Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (Server-side admin/seeding only - never expose to client!)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set this to the deployed Cloudflare Pages origin in the Pages environment.
# Signup confirmation uses the current browser origin automatically.
